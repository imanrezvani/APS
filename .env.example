# Environment variables for the APS Engine PostgreSQL persistence layer.
# Copy to `.env` for local development and fill in your own values.
# NEVER commit a real `.env` file or real credentials.

# SQLAlchemy URL (PostgreSQL via psycopg 3). Required by aps_persistence
# when a database connection is actually needed; engine-only/CLI workflows
# do not require it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/aps_engine

# Optional connection-pool tuning.
APS_DB_POOL_SIZE=5
APS_DB_MAX_OVERFLOW=10
APS_DB_POOL_TIMEOUT=30
APS_DB_POOL_RECYCLE=1800
APS_DB_ECHO=false

# Test database used by the persistence test-suite (PostgreSQL semantics).
APS_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/aps_engine_test
